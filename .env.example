# Copy to .env and replace EVERY placeholder. Never commit .env.
# Generate secrets with:  sh scripts/generate-secrets.sh   (prints a ready-to-paste block)

# --- Public URL (used for CORS allow-list and password reset links) ---
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=false

# --- MongoDB (root is used only by the init script; services use per-database users) ---
MONGO_ROOT_USER=root_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_min_24_chars
MONGO_APP_PASSWORD=CHANGE_ME_min_24_chars

# --- Redis / RabbitMQ ---
REDIS_PASSWORD=CHANGE_ME_min_24_chars
RABBITMQ_USER=parking_mq
RABBITMQ_PASSWORD=CHANGE_ME_min_24_chars

# --- Application secrets (each at least 32 chars; ENCRYPTION_KEY must be 32 random bytes, base64) ---
JWT_ACCESS_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_64_hex_chars
INTERNAL_API_KEY=CHANGE_ME_64_hex_chars
QR_SIGNING_SECRET=CHANGE_ME_64_hex_chars
ENCRYPTION_KEY=CHANGE_ME_base64_of_32_random_bytes

# --- First administrator (created only if no admin exists; remove the password from .env afterwards) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password_with_Upper_lower_and_digits

# --- Test payments: lets customers mark a booking "paid" using a clearly-labelled SIMULATED payment (no real money).
# Keep false in production unless a real payment gateway is wired in. true is fine for local demos. ---
ENABLE_DEMO_PAYMENT=false

# --- Rate limiting ---
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT=20

# --- Optional: SMTP for password-reset emails (without it, resets are only logged in non-production) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Optional: vehicle detector (YOLO inference server implementing POST /detect). Camera auto-detection is disabled without it. ---
DETECTOR_URL=
DETECTOR_API_KEY=

# --- Optional: footer contact details (hidden when empty) ---
SUPPORT_EMAIL=
SUPPORT_PHONE=
